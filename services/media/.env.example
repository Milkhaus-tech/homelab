# WireGuard tunnel for gluetun — values from your VPN provider's WireGuard config
WIREGUARD_PRIVATE_KEY=your_wireguard_private_key
WIREGUARD_PUBLIC_KEY=vpn_server_public_key
WIREGUARD_ENDPOINT_IP=203.0.113.1
WIREGUARD_ENDPOINT_PORT=51820
WIREGUARD_ADDRESSES=10.2.0.2/32

# *arr API keys (Settings → General in each app) — consumed by unpackerr
SONARR_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RADARR_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
