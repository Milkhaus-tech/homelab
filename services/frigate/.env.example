# Camera admin login (ONVIF + RTSP main/sub streams on every Tapo camera)
FRIGATE_CAMERA_USER=camera_admin
FRIGATE_CAMERA_PASSWORD=camera_password

# MQTT broker credential — must match the mosquitto passwd entry for user "mqtt"
FRIGATE_MQTT_PASSWORD=mqtt_password

# Auth for Frigate's own RTSP restream endpoint (go2rtc, port 8554)
FRIGATE_RTSP_PASSWORD=restream_password
