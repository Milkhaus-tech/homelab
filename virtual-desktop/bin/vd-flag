#!/bin/sh
# Alert Noah through Westly on jesus (Discord DM outbox + SMS + Telegram fan-out).
# Agents: call this when blocked on a login wall / 2FA / captcha, then stop or poll.
REASON="${*:-agent needs attention on the virtual desktop}"
printf '%s\t%s\n' "$(date -Is)" "$REASON" >> /home/noah/vd-attention.log
printf '%s' "$REASON" | ssh -o BatchMode=yes -o ConnectTimeout=6 jesus \
    'xargs -0 /home/noah/bin/vd-flag' \
    || { echo "vd-flag: westly alert via jesus failed" >&2; exit 1; }
