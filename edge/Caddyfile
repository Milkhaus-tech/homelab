stats.milkhaus.net {
    encode zstd gzip
    handle_path /manage/* {
        reverse_proxy 10.0.0.2:8102
    }
    redir /manage /manage/ 308
    handle {
        reverse_proxy 10.0.0.2:8101
    }
}

