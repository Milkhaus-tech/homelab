    reverse_proxy 10.0.0.2:8089
}

mc.milkhaus.net {
    reverse_proxy 10.0.0.2:8093
}

www.milkhaus.net {
    redir https://milkhaus.net{uri} permanent
}

davidsonstechservices.com {
	root * /var/www/davidsonstech
	encode zstd gzip
	try_files {path} {path}/ /index.html
	file_server
}

www.davidsonstechservices.com {
	redir https://davidsonstechservices.com{uri} permanent
}

